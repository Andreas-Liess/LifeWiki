{
  "name": "lifewiki",
  "version": "1.0.0",
  "private": true,
  "description": "Turns a folder of Obsidian notes into a static wiki.",
  "type": "module",
  "scripts": {
    "build": "node app/build.js",
    "dev": "node app/build.js && node app/serve.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "katex": "^0.16.47",
